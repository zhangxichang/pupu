import { Login } from "./auth/login.slint";
import { Register } from "./auth/register.slint";
import { PickOptions } from "../../../models/file_picker.slint";

component AuthTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;

    horizontal-stretch: 1;
    height: 100%;
    border-radius: 6px;
    background: root.active ? #ffffff : touch.has-hover ? #f5f5f5 : transparent;

    Text {
        text: root.label;
        width: 100%;
        height: 100%;
        font-size: 12px;
        font-weight: FontWeight.medium;
        color: root.active ? #222222 : #777777;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }
}

export component Auth inherits Rectangle {
    in-out property <bool> show_register: false;
    in-out property <image> register_avatar_image;
    in-out property <bool> register_has_avatar: false;

    callback login_requested(account_id: string);
    callback register_requested(username: string);
    callback pick_register_avatar(options: PickOptions);

    property <length> content_width: min(root.width - 48px, 360px);

    background: #f7f7f7;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        cross-axis-alignment: center;

        VerticalLayout {
            width: root.content_width;
            cross-axis-alignment: start;
            spacing: 10px;

            Rectangle {
                width: 104px;
                height: 32px;
                vertical-stretch: 0;
                border-radius: 8px;
                background: #e9e9e9;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 2px;
                    spacing: 2px;

                    AuthTab {
                        label: "登录";
                        active: !root.show_register;

                        clicked => {
                            root.show_register = false;
                        }
                    }

                    AuthTab {
                        label: "注册";
                        active: root.show_register;

                        clicked => {
                            root.show_register = true;
                        }
                    }
                }
            }

            if root.show_register: Register {
                vertical-stretch: 0;
                register_avatar_image: root.register_avatar_image;
                register_has_avatar: root.register_has_avatar;

                register_requested(username) => {
                    root.register_has_avatar = false;
                    root.show_register = false;
                    root.register_requested(username);
                }

                pick_register_avatar(options) => {
                    root.pick_register_avatar(options);
                }
            }

            if !root.show_register: Login {
                vertical-stretch: 0;

                login_requested(account_id) => {
                    root.login_requested(account_id);
                }
            }
        }
    }
}
