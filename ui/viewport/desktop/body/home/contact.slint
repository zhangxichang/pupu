import { ListView } from "std-widgets.slint";
import { Avatar } from "../../../../components/avatar.slint";
import { EmptyState } from "../../../../components/empty_state.slint";
import { HoverScrollBar } from "../../../../components/hover_scroll_bar.slint";
import { SidebarHeader } from "../../../../components/sidebar_header.slint";
import { ContactData } from "../../../../models/contact.slint";
import { ContactListItem } from "../../../../components/contact_list_item.slint";
import { Button } from "../../../../components/button.slint";
import { IconSet, IconDisplay } from "../../../../lib/lucide.slint";

export component Contact inherits HorizontalLayout {
    in-out property <int> current_contact: -1;
    in-out property <[ContactData]> contacts: [
        {
            name: "张伟",
            avatar_text: "张",
            signature: "今天也要好好吃饭",
            online: true,
            chat_index: 0
        },
        {
            name: "李娜",
            avatar_text: "李",
            signature: "把复杂的事做简单",
            online: false,
            chat_index: 1
        },
        {
            name: "王强",
            avatar_text: "王",
            signature: "行动胜于言辞",
            online: true,
            chat_index: 2
        },
        {
            name: "刘洋",
            avatar_text: "刘",
            signature: "记录生活里的每个瞬间",
            online: false,
            chat_index: 3
        },
        {
            name: "陈静",
            avatar_text: "陈",
            signature: "保持好奇",
            online: true,
            chat_index: 4
        },
        {
            name: "杨帆",
            avatar_text: "杨",
            signature: "永远在路上",
            online: false,
            chat_index: 5
        },
        {
            name: "赵磊",
            avatar_text: "赵",
            signature: "代码即诗",
            online: true,
            chat_index: 6
        },
        {
            name: "孙丽",
            avatar_text: "孙",
            signature: "慢慢来，比较快",
            online: false,
            chat_index: 7
        },
        {
            name: "周杰",
            avatar_text: "周",
            signature: "多读书，少熬夜",
            online: true,
            chat_index: 8
        },
        {
            name: "吴敏",
            avatar_text: "吴",
            signature: "今日事今日毕",
            online: false,
            chat_index: 9
        },
    ];

    callback message_requested(int);

    property <bool> has_contact:
        root.current_contact >= 0 && root.current_contact < root.contacts.length;

    property <ContactData> current_contact_data:
        root.has_contact
        ? root.contacts[root.current_contact]
        : { name: "", avatar_text: "", signature: "", online: false, chat_index: -1 };

    VerticalLayout {
        width: 250px;

        SidebarHeader {
            title: "联系人";
            search_placeholder: "搜索联系人";
        }

        VerticalLayout {
            vertical-stretch: 1;
            padding: 8px;
            spacing: 4px;

            touch := TouchArea {
                fs := FocusScope {
                    focus-on-click: false;
                    focus-on-tab-navigation: false;
                }

                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        fs.focus();
                    }
                }

                list := ListView {
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                    for contact[index] in root.contacts: VerticalLayout {
                        padding-top: 2px;
                        padding-bottom: 2px;

                        states [
                            spacing_begin when index == 0: {
                                padding-top: 0px;
                                padding-bottom: 2px;
                            }
                            spacing_end when index == root.contacts.length - 1: {
                                padding-top: 2px;
                                padding-bottom: 0px;
                            }
                        ]

                        ContactListItem {
                            contact: contact;
                            active: root.current_contact == index;

                            clicked => {
                                root.current_contact = index;
                            }
                        }
                    }
                }

                HoverScrollBar {
                    x: parent.width - 8px;
                    width: 12px;
                    height: parent.height;
                    content_y <=> list.content-y;
                    content_height: list.content-height;
                    visible_height: list.visible-height;
                    hovered: touch.has-hover;
                    interaction_started => { fs.focus(); }
                }
            }
        }
    }

    Rectangle {
        width: 1px;
        background: #eeeeee;
    }

    Rectangle {
        width: root.width - 251px;
        clip: true;

        VerticalLayout {
            width: 100%;
            height: 100%;

            HorizontalLayout {
                height: 48px;
                padding-left: 16px;
                padding-right: 16px;
                cross-axis-alignment: center;

                Text {
                    text: "联系人资料";
                    font-size: 14px;
                    font-weight: FontWeight.semi-bold;
                    color: #333333;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 1px;
                background: #eeeeee;
            }

            if root.has_contact: Rectangle {
                vertical-stretch: 1;
                max-height: 100000px;

                hover_touch := TouchArea {
                }

                detail_list := Flickable {
                    mouse-drag-pan-enabled: false;
                    content-width: self.width;
                    content-height: detail_layout.preferred-height;

                    detail_layout := VerticalLayout {
                        width: parent.width;
                        height: self.preferred-height;
                        padding-top: 56px;
                        padding-bottom: 40px;
                        cross-axis-alignment: center;

                        VerticalLayout {
                            width: min(parent.width, 360px);
                            cross-axis-alignment: center;

                            Avatar {
                                size: 80px;
                                font_size: 28px;
                                text: root.current_contact_data.avatar_text;
                                fill: #e8e8e8;
                            }

                            Rectangle {
                                height: 18px;
                            }

                            Text {
                                text: root.current_contact_data.name;
                                width: 100%;
                                font-size: 22px;
                                font-weight: FontWeight.semi-bold;
                                color: #222222;
                                horizontal-alignment: center;
                            }

                            Rectangle {
                                height: 7px;
                            }

                            HorizontalLayout {
                                spacing: 5px;
                                cross-axis-alignment: center;

                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: self.width / 2;
                                    background: root.current_contact_data.online ? #3ca55c : #b8b8b8;
                                }

                                Text {
                                    text: root.current_contact_data.online ? "在线" : "离线";
                                    font-size: 11px;
                                    color: #777777;
                                }
                            }

                            Rectangle {
                                height: 7px;
                            }

                            Text {
                                text: root.current_contact_data.signature;
                                width: 300px;
                                font-size: 12px;
                                color: #888888;
                                horizontal-alignment: center;
                                overflow: elide;
                                max-lines: 2;
                            }

                            Rectangle {
                                height: 26px;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                cross-axis-alignment: center;

                                Button {
                                    height: 34px;
                                    border-radius: 6px;
                                    normal_background: #333333;
                                    hover_background: #444444;
                                    pressed_background: #222222;
                                    content-padding-left: 14px;
                                    content-padding-right: 14px;
                                    content-spacing: 6px;

                                    IconDisplay {
                                        icon: IconSet.MessageCircle;
                                        size: 15px;
                                    }

                                    Text {
                                        text: "发消息";
                                        font-size: 12px;
                                        font-weight: FontWeight.medium;
                                        color: #ffffff;
                                    }

                                    clicked => {
                                        if (root.has_contact) {
                                            root.message_requested(root.current_contact_data.chat_index);
                                        }
                                    }
                                }

                                Button {
                                    height: 34px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #e5e5e5;
                                    normal_background: #ffffff;
                                    hover_background: #f7f7f7;
                                    pressed_background: #eeeeee;
                                    content-padding-left: 13px;
                                    content-padding-right: 13px;
                                    content-spacing: 6px;

                                    IconDisplay {
                                        icon: IconSet.Phone;
                                        size: 15px;
                                        stroke: #444444;
                                    }

                                    Text {
                                        text: "语音通话";
                                        font-size: 12px;
                                        color: #333333;
                                    }
                                }

                                Button {
                                    height: 34px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #e5e5e5;
                                    normal_background: #ffffff;
                                    hover_background: #f7f7f7;
                                    pressed_background: #eeeeee;
                                    content-padding-left: 13px;
                                    content-padding-right: 13px;
                                    content-spacing: 6px;

                                    IconDisplay {
                                        icon: IconSet.Video;
                                        size: 15px;
                                        stroke: #444444;
                                    }

                                    Text {
                                        text: "视频通话";
                                        font-size: 12px;
                                        color: #333333;
                                    }
                                }
                            }

                            Rectangle {
                                height: 40px;
                            }

                            Rectangle {
                                width: 280px;
                                height: 1px;
                                background: #eeeeee;
                            }

                            Rectangle {
                                height: 14px;
                            }

                            Button {
                                height: 32px;
                                border-radius: 6px;
                                hover_background: #fdf2f2;
                                pressed_background: #fbe6e6;
                                content-padding-left: 10px;
                                content-padding-right: 10px;
                                content-spacing: 6px;

                                IconDisplay {
                                    icon: IconSet.Trash2;
                                    size: 14px;
                                    stroke: #d9534f;
                                }

                                Text {
                                    text: "删除联系人";
                                    font-size: 12px;
                                    color: #d9534f;
                                }

                                clicked => {
                                    root.contacts.remove(root.current_contact);
                                    root.current_contact = -1;
                                }
                            }
                        }
                    }
                }

                HoverScrollBar {
                    x: parent.width - 18px;
                    width: 12px;
                    height: parent.height;
                    content_y <=> detail_list.content-y;
                    content_height: detail_list.content-height;
                    visible_height: detail_list.height;
                    hovered: hover_touch.has-hover;
                }
            }

            if !root.has_contact: Rectangle {
                vertical-stretch: 1;
                max-height: 100000px;

                EmptyState {
                    icon: IconSet.Contact;
                    text: "选择一个联系人查看详情";
                }
            }
        }
    }
}
