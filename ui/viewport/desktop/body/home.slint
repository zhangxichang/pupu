import { Button } from "../../../components/button.slint";
import { IconSet, IconDisplay } from "../../../lib/lucide.slint";
import { PrivateChat } from "./home/private_chat.slint";
import { GroupChat } from "./home/group_chat.slint";
import { Contact } from "./home/contact.slint";
import { Settings } from "./home/settings.slint";
import {
    Contributor,
    ContributorStatus,
} from "../../../models/contributor.slint";
import { ConversationItemData } from "../../../models/conversation.slint";
import { MessageData } from "../../../models/message.slint";
import { GroupMemberData } from "../../../models/group_member.slint";

enum ViewType { PrivateChat, GroupChat, Contact, Settings }

export component Home inherits HorizontalLayout {
    in-out property <ViewType> current_view: ViewType.PrivateChat;
    in-out property <[ConversationItemData]> private_conversations: [];
    in-out property <[[MessageData]]> private_threads: [];
    in-out property <[ConversationItemData]> group_conversations: [];
    in-out property <[[MessageData]]> group_threads: [];
    in-out property <[[GroupMemberData]]> group_members: [];
    in-out property <int> private_conversation: -1;
    in-out property <int> contact_selection: -1;
    in property <string> app_version;
    in property <[Contributor]> contributors;
    in property <ContributorStatus> contributor_status: ContributorStatus.Loading;
    in property <bool> show_version: true;
    in property <bool> enabled_update_check: false;

    callback check_update_requested;
    callback open_url(url: string);

    VerticalLayout {
        padding: 6px;
        cross-axis-alignment: center;
        spacing: 4px;

        Button {
            content-padding: 4px;
            border-radius: 10px;
            active: current_view == ViewType.PrivateChat;

            IconDisplay {
                icon: IconSet.MessageCircle;
                size: 30px;
                stroke: current_view == ViewType.PrivateChat ? #ffffff : #888888;
            }

            clicked => { current_view = ViewType.PrivateChat; }
        }

        Button {
            content-padding: 4px;
            border-radius: 10px;
            active: current_view == ViewType.GroupChat;

            IconDisplay {
                icon: IconSet.Users;
                size: 30px;
                stroke: current_view == ViewType.GroupChat ? #ffffff : #888888;
            }

            clicked => { current_view = ViewType.GroupChat; }
        }

        Button {
            content-padding: 4px;
            border-radius: 10px;
            active: current_view == ViewType.Contact;

            IconDisplay {
                icon: IconSet.Contact;
                size: 30px;
                stroke: current_view == ViewType.Contact ? #ffffff : #888888;
            }

            clicked => { current_view = ViewType.Contact; }
        }

        Rectangle { }

        Button {
            content-padding: 4px;
            border-radius: 10px;
            active: current_view == ViewType.Settings;

            IconDisplay {
                icon: IconSet.Settings;
                size: 30px;
                stroke: current_view == ViewType.Settings ? #ffffff : #888888;
            }

            clicked => { current_view = ViewType.Settings; }
        }
    }

    Rectangle {
        width: 1px;
        background: #eeeeee;
    }

    Rectangle {
        width: parent.width - 49px;

        PrivateChat {
            visible: root.current_view == ViewType.PrivateChat;
            width: 100%;
            height: 100%;
            conversations: root.private_conversations;
            threads: root.private_threads;
            current_conversation <=> root.private_conversation;
        }

        GroupChat {
            visible: root.current_view == ViewType.GroupChat;
            width: 100%;
            height: 100%;
            conversations: root.group_conversations;
            threads: root.group_threads;
            group_members: root.group_members;
        }

        Contact {
            visible: root.current_view == ViewType.Contact;
            width: 100%;
            height: 100%;
            current_contact <=> root.contact_selection;

            message_requested(index) => {
                root.private_conversation = index;
                root.current_view = ViewType.PrivateChat;
            }
        }

        Settings {
            visible: root.current_view == ViewType.Settings;
            width: 100%;
            height: 100%;
            app_version: root.app_version;
            contributors: root.contributors;
            contributor_status: root.contributor_status;
            show_version: root.show_version;
            enabled_update_check: root.enabled_update_check;

            check_update_requested => {
                root.check_update_requested();
            }

            open_url(url) => {
                root.open_url(url);
            }
        }
    }
}
