import { Header } from "./desktop/header.slint";
import { Body } from "./desktop/body.slint";
import { UpdateDialog } from "../components/update_dialog.slint";
import {
    Contributor,
    ContributorStatus,
} from "../models/contributor.slint";
import { ConversationItemData } from "../models/conversation.slint";
import { MessageData } from "../models/message.slint";
import { GroupMemberData } from "../models/group_member.slint";
import { PickOptions } from "../models/file_picker.slint";

export enum WindowResizeDirection {
    NorthWest,
    North,
    NorthEast,
    East,
    SouthEast,
    South,
    SouthWest,
    West,
}

export component Desktop inherits Rectangle {
    in property <bool> is_desktop;
    in property <bool> show_version: true;
    in property <bool> maximized: false;
    in property <string> app_version;
    in property <[Contributor]> contributors;
    in property <ContributorStatus> contributor_status: ContributorStatus.Loading;
    in-out property <[ConversationItemData]> private_conversations: [];
    in-out property <[[MessageData]]> private_threads: [];
    in-out property <[ConversationItemData]> group_conversations: [];
    in-out property <[[MessageData]]> group_threads: [];
    in-out property <[[GroupMemberData]]> group_members: [];
    in-out property <image> register_avatar_image;
    in-out property <bool> register_has_avatar: false;

    property <bool> update_available;
    property <bool> show_update_dialog: false;
    property <string> latest_version;

    property <bool> show_window_chrome: root.is_desktop && !root.maximized;
    property <length> window_chrome_margin: root.show_window_chrome ? 16px : 0px;
    property <length> resize_hit_width: 8px;

    callback drag_window;
    callback resize_window(direction: WindowResizeDirection);
    callback minimize_window;
    callback toggle_maximized;
    callback close_window;
    callback get_latest_version() -> string;
    callback compare_versions(a: string, b: string) -> int;
    callback open_url(url: string);
    callback pick_register_avatar(options: PickOptions);

    update_check_timer := Timer {
        interval: 0ms;

        triggered => {
            root.update_available = root.compare_versions(root.get_latest_version(), root.app_version) > 0;
            update_check_timer.running = false;
        }
    }

    function open_update_dialog() {
        root.latest_version = root.get_latest_version();
        root.show_update_dialog = true;
    }

    function handle_resize_event(event: PointerEvent, direction: WindowResizeDirection) {
        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
            root.resize_window(direction);
        }
    }

    Rectangle {
        x: root.window_chrome_margin;
        y: root.window_chrome_margin;
        width: root.width - 2 * root.window_chrome_margin;
        height: root.height - 2 * root.window_chrome_margin;

        background: #ffffff;
        clip: root.show_window_chrome;
        border-radius: root.show_window_chrome ? 8px : 0px;
        border-width: root.show_window_chrome ? 1px : 0px;
        border-color: #00000033;

        drop-shadow-color: root.show_window_chrome ? #00000033 : transparent;
        drop-shadow-blur: 12px;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: 2px;

        FocusScope {
            focus-on-tab-navigation: false;

            VerticalLayout {
                width: 100%;
                height: 100%;
                cross-axis-alignment: stretch;

                Header {
                    enabled_window_chrome: root.is_desktop;
                    show_update_notification: root.is_desktop && body.logged_in && root.update_available;
                    maximized: root.maximized;
                    logged_in: body.logged_in;

                    drag_window => { root.drag_window() }
                    minimize_window => { root.minimize_window() }
                    toggle_maximized => { root.toggle_maximized() }
                    close_window => { root.close_window() }
                    update_clicked => { root.open_update_dialog() }
                }

                Rectangle {
                    height: 1px;
                    background: #eeeeee;
                }

                Rectangle {
                    width: parent.width;
                    height: parent.height - 33px;

                    body := Body {
                        width: 100%;
                        height: 100%;
                        private_conversations: root.private_conversations;
                        private_threads: root.private_threads;
                        group_conversations: root.group_conversations;
                        group_threads: root.group_threads;
                        group_members: root.group_members;
                        register_avatar_image <=> root.register_avatar_image;
                        register_has_avatar <=> root.register_has_avatar;
                        app_version: root.app_version;
                        contributors: root.contributors;
                        contributor_status: root.contributor_status;
                        show_version: root.show_version;
                        enabled_update_check: root.is_desktop;

                        check_update_requested => {
                            root.open_update_dialog();
                        }

                        open_url(url) => {
                            root.open_url(url);
                        }

                        pick_register_avatar(options) => {
                            root.pick_register_avatar(options);
                        }
                    }
                }
            }
        }

        if root.show_update_dialog: Rectangle {
            y: 33px;
            width: 100%;
            height: parent.height - 33px;

            UpdateDialog {
                app_version: root.app_version;
                latest_version: root.latest_version;

                dismissed => { root.show_update_dialog = false; }
                update_requested => { root.show_update_dialog = false; }
            }
        }
    }

    if root.show_window_chrome: Rectangle {
        x: 0;
        y: 0;

        property <length> margin: root.window_chrome_margin;
        property <length> half: root.resize_hit_width / 2;
        property <length> edge_width: root.width - 2 * margin - root.resize_hit_width;
        property <length> edge_height: root.height - 2 * margin - root.resize_hit_width;

        TouchArea {
            x: margin - half;
            y: margin - half;
            width: root.resize_hit_width;
            height: root.resize_hit_width;
            mouse-cursor: nw-resize;

            pointer-event(event) => { root.handle_resize_event(event, WindowResizeDirection.NorthWest) }
        }

        TouchArea {
            x: margin + half;
            y: margin - half;
            width: edge_width;
            height: root.resize_hit_width;
            mouse-cursor: n-resize;

            pointer-event(event) => { root.handle_resize_event(event, WindowResizeDirection.North) }
        }

        TouchArea {
            x: root.width - margin - half;
            y: margin - half;
            width: root.resize_hit_width;
            height: root.resize_hit_width;
            mouse-cursor: ne-resize;

            pointer-event(event) => { root.handle_resize_event(event, WindowResizeDirection.NorthEast) }
        }

        TouchArea {
            x: root.width - margin - half;
            y: margin + half;
            width: root.resize_hit_width;
            height: edge_height;
            mouse-cursor: e-resize;

            pointer-event(event) => { root.handle_resize_event(event, WindowResizeDirection.East) }
        }

        TouchArea {
            x: root.width - margin - half;
            y: root.height - margin - half;
            width: root.resize_hit_width;
            height: root.resize_hit_width;
            mouse-cursor: se-resize;

            pointer-event(event) => { root.handle_resize_event(event, WindowResizeDirection.SouthEast) }
        }

        TouchArea {
            x: margin + half;
            y: root.height - margin - half;
            width: edge_width;
            height: root.resize_hit_width;
            mouse-cursor: s-resize;

            pointer-event(event) => { root.handle_resize_event(event, WindowResizeDirection.South) }
        }

        TouchArea {
            x: margin - half;
            y: root.height - margin - half;
            width: root.resize_hit_width;
            height: root.resize_hit_width;
            mouse-cursor: sw-resize;

            pointer-event(event) => { root.handle_resize_event(event, WindowResizeDirection.SouthWest) }
        }

        TouchArea {
            x: margin - half;
            y: margin + half;
            width: root.resize_hit_width;
            height: edge_height;
            mouse-cursor: w-resize;

            pointer-event(event) => { root.handle_resize_event(event, WindowResizeDirection.West) }
        }
    }
}
