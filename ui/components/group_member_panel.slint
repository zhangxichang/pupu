import { ListView } from "std-widgets.slint";
import { Avatar } from "./avatar.slint";
import { HoverScrollBar } from "./hover_scroll_bar.slint";
import { GroupMemberData } from "../models/group_member.slint";

component GroupMemberItem inherits Rectangle {
    in property <GroupMemberData> member;

    callback pressed;

    height: 44px;

    states [
        hovered when touch.has-hover: {
            background: #f7f7f7;
        }
    ]

    touch := TouchArea {
        mouse-cursor: pointer;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.pressed();
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 18px;
        spacing: 9px;
        cross-axis-alignment: center;

        Avatar {
            size: 28px;
            font_size: 11px;
            text: root.member.avatar_text;
            fill: #ececec;
            show_presence: true;
            online: root.member.online;
        }

        Text {
            text: root.member.name;
            font-size: 12px;
            color: #333333;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }

        if root.member.role != "": Text {
            text: root.member.role;
            font-size: 9px;
            color: #999999;
            vertical-alignment: center;
        }
    }
}

export component GroupMemberPanel inherits Rectangle {
    in property <[GroupMemberData]> members;

    callback scroll_started;

    background: #ffffff;

    callback pressed;

    VerticalLayout {
        width: 100%;
        height: 100%;

        HorizontalLayout {
            height: 40px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 5px;
            cross-axis-alignment: center;

            Text {
                text: "群成员";
                height: parent.height;
                font-size: 12px;
                font-weight: FontWeight.medium;
                color: #333333;
                vertical-alignment: center;
            }

            Text {
                text: root.members.length;
                height: parent.height;
                font-size: 10px;
                color: #999999;
                vertical-alignment: center;
            }

            Rectangle { }
        }

        Rectangle {
            height: 1px;
            background: #eeeeee;
        }

        touch := TouchArea {
            vertical-stretch: 1;

            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.pressed();
                }
            }

            list := ListView {
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                for member in root.members: GroupMemberItem {
                    member: member;

                    pressed => {
                        root.pressed();
                    }
                }
            }

            HoverScrollBar {
                x: parent.width - 18px;
                width: 12px;
                height: parent.height;
                content_y <=> list.content-y;
                content_height: list.content-height;
                visible_height: list.visible-height;
                hovered: touch.has-hover;
                interaction_started => { root.scroll_started(); }
            }
        }
    }
}
