import { HoverScrollBar } from "./hover_scroll_bar.slint";
import { MessageItem } from "./message_item.slint";
import { MessageData } from "../models/message.slint";
import { VirtualListSlot } from "../models/virtual_list_layout.slint";

export component VirtualList inherits Rectangle {
    in property <[MessageData]> messages;
    in property <[VirtualListSlot]> slots;
    in property <length> content_height;
    in property <bool> group;
    in-out property <bool> scroll_to_bottom;
    in-out property <length> content_y;

    callback set_height(index: int, height: length);
    callback set_viewport(offset: length, height: length);
    callback pressed;

    pure function shows_avatar(index: int) -> bool {
        if (index <= 0 || index >= root.messages.length) {
            return true;
        }
        if (root.group) {
            return root.messages[index].sender_name != root.messages[index - 1].sender_name;
        }
        return root.messages[index].is_self != root.messages[index - 1].is_self;
    }

    pure function shows_sender(index: int) -> bool {
        if (!root.group || index < 0 || index >= root.messages.length) {
            return false;
        }
        let message = root.messages[index];
        return !message.is_self && (index == 0 || root.messages[index - 1].sender_name != message.sender_name);
    }

    hover_touch := TouchArea {

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.pressed();
            }
        }
    }

    list := Flickable {
        width: 100%;
        height: 100%;
        mouse-drag-pan-enabled: false;
        content-width: self.width;
        content-height: root.content_height;
        content_y <=> root.content_y;

        changed content-y => {
            root.set_viewport(-self.content-y, self.height);
        }

        Rectangle {
            width: parent.width;
            height: root.content_height;

            for slot in root.slots: VerticalLayout {
                y: slot.y;
                width: 100%;
                height: slot.index >= 0 ? self.preferred-height : 0px;

                padding-left: slot.index >= 0 ? 16px : 0px;
                padding-right: slot.index >= 0 ? 16px : 0px;
                padding-top: slot.index == 0 ? 12px : 0px;
                padding-bottom: slot.index >= 0 ? 9px : 0px;

                if slot.index >= 0 && slot.index < root.messages.length: MessageItem {
                    message: root.messages[slot.index];
                    show_avatar: root.shows_avatar(slot.index);
                    show_sender: root.shows_sender(slot.index);
                    show_time: root.messages[slot.index].time != "";
                }

                changed height => {
                    if slot.index >= 0 && self.height >= 24px {
                        root.set_height(slot.index, self.height);
                    }
                }
            }
        }
    }

    HoverScrollBar {
        x: parent.width - 18px;
        width: 12px;
        height: parent.height;
        content_y <=> list.content-y;
        content_height: root.content_height;
        visible_height: root.height;
        hovered: hover_touch.has-hover;
        interaction_started => { root.pressed(); }
    }

    changed height => {
        root.set_viewport(-root.content_y, root.height);
    }

    changed content_height => {
        if (root.scroll_to_bottom) {
            list.content-y = -max(0px, root.content_height - root.height);
        }
    }

    bottom_timer := Timer {
        interval: 1000ms;
        running: false;
        triggered => {
            root.scroll_to_bottom = false;
            bottom_timer.running = false;
        }
    }

    changed scroll_to_bottom => {
        if (root.scroll_to_bottom) {
            bottom_timer.running = true;
        } else {
            bottom_timer.running = false;
        }
    }
}
