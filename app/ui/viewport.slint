import {
    Desktop,
    WindowResizeDirection,
} from "./viewport/desktop.slint";
import { Mobile } from "./viewport/mobile.slint";
import { LoginAccount } from "./models/account.slint";
import { Contributor, ContributorStatus } from "./models/contributor.slint";
import { ContactData } from "./models/contact.slint";
import { ConversationItemData } from "./models/conversation.slint";
import { MessageData } from "./models/message.slint";
import { GroupMemberData } from "./models/group_member.slint";
import { PickOptions } from "./models/file_picker.slint";
export {
    VirtualListSlot,
    PrivateListLayout,
    GroupListLayout,
} from "./models/virtual_list_layout.slint";

export enum AppPlatform {
    Web,
    Mobile,
    Desktop,
}

export component Viewport inherits Window {
    in property <AppPlatform> platform;
    in property <string> app_version;
    in-out property <string> node_id: "";
    in-out property <[LoginAccount]> accounts: [];
    in-out property <string> account_avatar_text;
    in-out property <image> account_avatar_image;
    in-out property <bool> account_has_avatar: false;
    in property <[Contributor]> contributors;
    in property <ContributorStatus> contributor_status: ContributorStatus.Loading;
    in property <[ContactData]> contacts: [];
    in-out property <[ConversationItemData]> private_conversations: [];
    in-out property <[MessageData]> private_messages: [];
    in-out property <[ConversationItemData]> group_conversations: [];
    in-out property <[MessageData]> group_messages: [];
    in-out property <[GroupMemberData]> group_members: [];
    in-out property <int> private_conversation: -1;
    in-out property <int> group_conversation: -1;
    in-out property <string> private_draft: "";
    in-out property <string> group_draft: "";
    in-out property <image> register_avatar_image;
    in-out property <bool> register_has_avatar: false;
    in-out property <image> contact_avatar_image;
    in-out property <bool> contact_has_avatar: false;
    in-out property <image> group_avatar_image;
    in-out property <bool> group_has_avatar: false;

    property <bool> is_desktop: root.platform == AppPlatform.Desktop;

    callback drag_window;
    callback resize_window(direction: WindowResizeDirection);
    callback get_latest_version() -> string;
    callback compare_versions(a: string, b: string) -> int;
    callback open_url(url: string);
    callback copy_node_id;
    callback pick_register_avatar(options: PickOptions);
    callback login_requested(account_id: string);
    callback register_requested(username: string);
    callback pick_contact_avatar(options: PickOptions);
    callback contact_add_requested(name: string, bio: string, endpoint_id: string);
    callback contact_add_cancelled;
    callback pick_group_avatar(options: PickOptions);
    callback group_create_requested(name: string);
    callback group_create_cancelled;
    callback contact_message_requested(profile_id: string);
    callback contact_delete_requested(profile_id: string);
    callback contact_accept_requested(profile_id: string);
    callback contact_reject_requested(profile_id: string);
    callback private_conversation_selected(conversation_id: string);
    callback group_conversation_selected(conversation_id: string);
    callback private_message_send_requested(conversation_id: string, markdown: string);
    callback group_message_send_requested(conversation_id: string, markdown: string);
    callback private_file_requested(conversation_id: string);
    callback private_image_requested(conversation_id: string);
    callback group_file_requested(conversation_id: string);
    callback group_image_requested(conversation_id: string);

    no-frame: true;
    background: root.is_desktop ? transparent : #ffffff;
    default-font-family: "MiSans VF";
    title: "Pupu";
    preferred-width: 1250px;
    preferred-height: 825px;

    if root.platform != AppPlatform.Mobile: Desktop {
        width: 100%;
        height: 100%;
        is_desktop: root.is_desktop;
        show_version: root.platform != AppPlatform.Web;
        maximized: root.maximized;
        app_version: root.app_version;
        node_id <=> root.node_id;
        accounts: root.accounts;
        account_avatar_text: root.account_avatar_text;
        account_avatar_image: root.account_avatar_image;
        account_has_avatar: root.account_has_avatar;
        contributors: root.contributors;
        contributor_status: root.contributor_status;
        contacts: root.contacts;
        private_conversations: root.private_conversations;
        private_messages: root.private_messages;
        group_conversations: root.group_conversations;
        group_messages: root.group_messages;
        group_members: root.group_members;
        private_conversation <=> root.private_conversation;
        group_conversation <=> root.group_conversation;
        private_draft <=> root.private_draft;
        group_draft <=> root.group_draft;
        register_avatar_image <=> root.register_avatar_image;
        register_has_avatar <=> root.register_has_avatar;
        contact_avatar_image <=> root.contact_avatar_image;
        contact_has_avatar <=> root.contact_has_avatar;
        group_avatar_image <=> root.group_avatar_image;
        group_has_avatar <=> root.group_has_avatar;

        drag_window => { root.drag_window() }
        copy_node_id => { root.copy_node_id() }
        pick_register_avatar(options) => { root.pick_register_avatar(options) }
        login_requested(account_id) => { root.login_requested(account_id) }
        register_requested(username) => { root.register_requested(username) }
        pick_contact_avatar(options) => { root.pick_contact_avatar(options) }
        contact_add_requested(name, bio, endpoint_id) => { root.contact_add_requested(name, bio, endpoint_id) }
        contact_accept_requested(profile_id) => { root.contact_accept_requested(profile_id) }
        contact_reject_requested(profile_id) => { root.contact_reject_requested(profile_id) }
        contact_add_cancelled => { root.contact_add_cancelled() }
        pick_group_avatar(options) => { root.pick_group_avatar(options) }
        group_create_requested(name) => { root.group_create_requested(name) }
        group_create_cancelled => { root.group_create_cancelled() }
        contact_message_requested(profile_id) => { root.contact_message_requested(profile_id) }
        contact_delete_requested(profile_id) => { root.contact_delete_requested(profile_id) }
        private_conversation_selected(conversation_id) => { root.private_conversation_selected(conversation_id) }
        group_conversation_selected(conversation_id) => { root.group_conversation_selected(conversation_id) }
        private_message_send_requested(conversation_id, markdown) => { root.private_message_send_requested(conversation_id, markdown) }
        group_message_send_requested(conversation_id, markdown) => { root.group_message_send_requested(conversation_id, markdown) }
        private_file_requested(conversation_id) => { root.private_file_requested(conversation_id) }
        private_image_requested(conversation_id) => { root.private_image_requested(conversation_id) }
        group_file_requested(conversation_id) => { root.group_file_requested(conversation_id) }
        group_image_requested(conversation_id) => { root.group_image_requested(conversation_id) }
        resize_window(direction) => { root.resize_window(direction) }
        minimize_window => { root.minimized = true; }
        toggle_maximized => { root.maximized = !root.maximized; }
        close_window => { root.close(); }
        get_latest_version => { return root.get_latest_version(); }
        compare_versions(a, b) => { return root.compare_versions(a, b); }
        open_url(url) => { root.open_url(url); }
    }

    if root.platform == AppPlatform.Mobile: Mobile {
        width: 100%;
        height: 100%;
    }
}
