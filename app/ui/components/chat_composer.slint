import { Button } from "./button.slint";
import { Input } from "./input.slint";
import { IconSet, IconDisplay, Icon } from "../lib/lucide.slint";

component ToolButton inherits Button {
    in property <Icon> icon;
    callback activated;

    content-padding: 6px;
    border-radius: 6px;
    pressed_background: #e5e5e5;
    hover_background: #f1f1f1;

    IconDisplay {
        icon: root.icon;
        size: 16px;
        stroke: #555555;
    }

    clicked => { root.activated(); }
}

export component ChatComposer inherits VerticalLayout {
    in-out property <string> text <=> editor.text;

    pure function is_blank(value: string) -> bool {
        return value.replace-all(" ", "").replace-all("\u{0009}", "").replace-all("\n", "").replace-all("\u{000d}", "").is-empty;
    }

    in property <bool> can_send: !root.is_blank(root.text);

    callback send_requested(text: string);
    callback attach_clicked;
    callback image_clicked;
    callback emoji_clicked;
    callback voice_message_clicked;

    public function focus-input() {
        editor.focus-input();
    }

    function request_send() {
        if (root.can_send) {
            root.send_requested(root.text);
            root.focus-input();
        }
    }

    Rectangle {
        height: 1px;
        background: #eeeeee;
    }

    HorizontalLayout {
        height: 34px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 1px;
        cross-axis-alignment: center;

        ToolButton {
            icon: IconSet.Paperclip;
            activated => { root.attach_clicked(); }
        }

        ToolButton {
            icon: IconSet.Image;
            activated => { root.image_clicked(); }
        }

        ToolButton {
            icon: IconSet.Smile;
            activated => { root.emoji_clicked(); }
        }

        ToolButton {
            icon: IconSet.Mic;
            activated => { root.voice_message_clicked(); }
        }

        HorizontalLayout {
            padding-left: 5px;
            padding-right: 5px;

            Rectangle {
                width: 1px;
                height: 15px;
                background: #eeeeee;
            }
        }
    }

    editor := Input {
        multiline: true;
        placeholder: "输入消息";
        font_size: 14px;
        min_content_height: 104px;
        max_content_height: 261px;
        inner_padding_left: 12px;
        inner_padding_right: 12px;
        inner_padding_top: 3px;
        inner_padding_bottom: 3px;

        key_pressed(event) => {
            if (event.modifiers.control && event.text == "\n") {
                root.request_send();
                accept
            } else {
                reject
            }
        }
    }

    HorizontalLayout {
        height: 38px;
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 8px;
        spacing: 8px;
        cross-axis-alignment: center;

        Rectangle { }

        Button {
            content-padding-top: 6px;
            content-padding-bottom: 6px;
            content-padding-left: 14px;
            content-padding-right: 8px;
            content-spacing: 5px;
            border-radius: 4px;
            normal_background: root.can_send ? #333333 : #cccccc;
            pressed_background: #666666;
            hover_background: #555555;
            enabled: root.can_send;

            clicked => { root.request_send(); }

            Text {
                text: "发送";
                color: #ffffff;
                font-size: 12px;
                font-weight: FontWeight.bold;
                vertical-alignment: center;
            }

            Text {
                text: "Ctrl + Enter";
                color: #ffffff;
                font-size: 8px;
                font-weight: FontWeight.bold;
                vertical-alignment: center;
                opacity: 0.75;
            }
        }
    }
}
