import { Avatar } from "./avatar.slint";
import { IconSet, IconDisplay } from "../lib/lucide.slint";
import {
    MessageAttachmentData,
    MessageAttachmentKind,
    MessageData,
} from "../models/message.slint";

export component MessageItem inherits Rectangle {
    in property <MessageData> message;
    in property <bool> show_avatar: true;
    in property <bool> show_sender: false;
    in property <bool> show_time: true;

    callback link_clicked(url: string);

    width: 100%;
    height: content.preferred-height + root.message.attachment_height;

    content := HorizontalLayout {
        width: 100%;
        alignment: root.message.is_self ? end : start;
        cross-axis-alignment: start;
        spacing: 7px;

        if !root.message.is_self && root.show_avatar: Avatar {
            size: 26px;
            font_size: 11px;
            text: root.message.avatar_text;
            image: root.message.avatar;
            show_image: root.message.has_avatar;
        }

        if !root.message.is_self && !root.show_avatar: Rectangle {
            width: 26px;
            height: 1px;
        }

        VerticalLayout {
            horizontal-stretch: 0;
            spacing: 2px;
            cross-axis-alignment: root.message.is_self ? end : start;

            if root.show_sender && !root.message.is_self: Text {
                text: root.message.sender_name;
                font-size: 12px;
                color: #777777;
            }

            if root.show_time: HorizontalLayout {
                spacing: 5px;

                Text {
                    text: root.message.time;
                    font-size: 10px;
                    color: #aaaaaa;
                }

                if root.message.is_self && root.message.status == "pending": Text {
                    text: "发送中";
                    font-size: 10px;
                    color: #aaaaaa;
                }

                if root.message.is_self && root.message.status == "failed": Text {
                    text: "发送失败";
                    font-size: 10px;
                    color: #d9534f;
                }

                if root.message.is_self && root.message.status == "sent" && root.message.read: Text {
                    text: "✓ 已读";
                    font-size: 10px;
                    color: #aaaaaa;
                }
            }

            if root.message.has_body: Rectangle {
                horizontal-stretch: 0;
                width: min(body_text.preferred-width + 20px, root.width * 0.72);
                height: body_text.preferred-height + 14px;
                border-radius: 10px;
                border-top-left-radius: root.message.is_self ? 10px : 3px;
                border-top-right-radius: root.message.is_self ? 3px : 10px;
                background: root.message.is_self ? #333333 : #f4f4f4;

                body_text := StyledText {
                    x: 10px;
                    y: 7px;
                    width: parent.width - 20px;
                    text: root.message.body;
                    default-color: root.message.is_self ? #ffffff : #2f2f2f;
                    default-font-size: 13px;
                    link-color: root.message.is_self ? #9cc4ff : #007aff;
                    selectable: true;

                    link-clicked(link) => {
                        root.link_clicked(link);
                    }
                }
            }

            for attachment in root.message.attachments: Rectangle {
                horizontal-stretch: 0;
                width: attachment.kind == MessageAttachmentKind.Image ? 200px : min(200px, root.width * 0.72);
                height: attachment.kind == MessageAttachmentKind.Image ? 150px : 46px;

                if attachment.kind == MessageAttachmentKind.Image: Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 8px;
                    background: #eeeeee;
                    clip: true;

                    if attachment.has_image: Image {
                        width: 100%;
                        height: 100%;
                        source: attachment.image;
                        image-fit: contain;
                    }

                    if !attachment.has_image: VerticalLayout {
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 4px;

                        IconDisplay {
                            icon: IconSet.Image;
                            size: 28px;
                            stroke: #aaaaaa;
                        }

                        Text {
                            text: attachment.name;
                            font-size: 10px;
                            color: #888888;
                            horizontal-alignment: center;
                        }
                    }
                }

                if attachment.kind == MessageAttachmentKind.File: Rectangle {
                    width: 100%;
                    height: 100%;
                    border-width: 1px;
                    border-color: #e7e7e7;
                    border-radius: 10px;
                    background: #fafafa;

                    file_content := HorizontalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 7px;
                            background: #ececec;

                            IconDisplay {
                                icon: IconSet.File;
                                size: 16px;
                                stroke: #555555;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            spacing: 1px;

                            Text {
                                text: attachment.name;
                                font-size: 12px;
                                font-weight: FontWeight.medium;
                                color: #2f2f2f;
                                width: 120px;
                                overflow: elide;
                            }

                            Text {
                                text: attachment.size;
                                font-size: 10px;
                                color: #777777;
                            }
                        }
                    }
                }
            }
        }

        if root.message.is_self && root.show_avatar: Avatar {
            size: 26px;
            font_size: 11px;
            text: root.message.avatar_text;
            image: root.message.avatar;
            show_image: root.message.has_avatar;
            fill: #cfcfcf;
        }

        if root.message.is_self && !root.show_avatar: Rectangle {
            width: 26px;
            height: 1px;
        }
    }
}
