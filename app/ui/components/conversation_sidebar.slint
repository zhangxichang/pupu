import { ListView } from "std-widgets.slint";
import { HoverScrollBar } from "./hover_scroll_bar.slint";
import { SidebarHeader } from "./sidebar_header.slint";
import { ConversationListItem } from "./conversation_list_item.slint";
import { ConversationItemData } from "../models/conversation.slint";

export component ConversationSidebar inherits VerticalLayout {
    in property <string> title;
    in property <string> search_placeholder;
    in property <[ConversationItemData]> conversations: [];
    in property <int> selected_index: -1;
    in property <bool> show_add: false;

    callback selected(index: int);
    callback add_clicked;

    width: 250px;

    SidebarHeader {
        title: root.title;
        search_placeholder: root.search_placeholder;
        show_add: root.show_add;

        add_clicked => {
            root.add_clicked();
        }
    }

    VerticalLayout {
        vertical-stretch: 1;
        padding: 8px;
        spacing: 4px;

        touch := TouchArea {
            fs := FocusScope {
                focus-on-click: false;
                focus-on-tab-navigation: false;
            }

            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    fs.focus();
                }
            }

            list := ListView {
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                for conversation[index] in root.conversations: VerticalLayout {
                    padding-top: 2px;
                    padding-bottom: 2px;

                    states [
                        spacing_begin when index == 0: {
                            padding-top: 0px;
                            padding-bottom: 2px;
                        }
                        spacing_end when index == root.conversations.length - 1: {
                            padding-top: 2px;
                            padding-bottom: 0px;
                        }
                    ]

                    ConversationListItem {
                        conversation: conversation;
                        active: root.selected_index == index;

                        clicked => {
                            root.selected(index);
                        }
                    }
                }
            }

            HoverScrollBar {
                x: parent.width - 8px;
                width: 12px;
                height: parent.height;
                content_y <=> list.content-y;
                content_height: list.content-height;
                visible_height: list.visible-height;
                hovered: touch.has-hover;
                interaction_started => { fs.focus(); }
            }
        }
    }
}
