import { Avatar } from "./avatar.slint";
import { ContactData } from "../models/contact.slint";

export component ContactListItem inherits Rectangle {
    in property <ContactData> contact;
    in property <bool> active;

    callback clicked;

    height: 48px;
    border-radius: 8px;
    clip: true;

    states [
        active when root.active: {
            background: #e0e0e0;
        }
        hover when touch.has-hover: {
            background: #f4f4f4;
        }
    ]

    fs := FocusScope {
        focus-on-tab-navigation: false;
    }

    touch := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            fs.focus();
            root.clicked();
        }
    }

    HorizontalLayout {
        cross-axis-alignment: center;
        padding: 8px;
        spacing: 8px;

        Avatar {
            text: root.contact.avatar_text;
            image: root.contact.avatar;
            show_image: root.contact.has_avatar;
            fill: root.active ? #c0c0c0 : #e0e0e0;
            show_presence: true;
            online: root.contact.online;
        }

        VerticalLayout {
            spacing: 3px;

            Text {
                text: root.contact.name;
                font-size: 14px;
                font-weight: FontWeight.medium;
            }

            Text {
                text: root.contact.signature;
                font-size: 11px;
                color: #999999;
                overflow: elide;
                max-lines: 1;
            }
        }
    }
}
