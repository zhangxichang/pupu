import { ListView } from "std-widgets.slint";
import { Avatar } from "../../../../components/avatar.slint";
import { HoverScrollBar } from "../../../../components/hover_scroll_bar.slint";
import { Button } from "../../../../components/button.slint";
import { SidebarHeader } from "../../../../components/sidebar_header.slint";
import { IconSet, IconDisplay, Icon } from "../../../../lib/lucide.slint";
import {
    Contributor,
    ContributorStatus,
} from "../../../../models/contributor.slint";

component SettingsNavItem inherits Rectangle {
    in property <bool> active: false;
    in property <string> label;
    in property <Icon> icon;

    callback clicked;

    height: 40px;
    border-radius: 8px;
    clip: true;
    background: root.active
        ? #e0e0e0
        : touch.has-hover ? #f4f4f4 : transparent;

    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        cross-axis-alignment: center;

        IconDisplay {
            icon: root.icon;
            size: 16px;
            stroke: root.active ? #333333 : #777777;
        }

        Text {
            text: root.label;
            font-size: 13px;
            color: root.active ? #222222 : #444444;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }
}

component ContributorRow inherits Rectangle {
    in property <image> avatar;
    in property <string> name;
    in property <string> login;
    in property <string> bio;

    callback clicked;

    width: 100%;
    height: 52px;
    border-radius: 8px;
    background: touch.has-hover ? #f4f4f4 : transparent;

    animate background { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        cross-axis-alignment: center;

        Avatar {
            show_image: true;
            image: root.avatar;
            fill: #ececec;
        }

        VerticalLayout {
            spacing: 1px;

            Text {
                text: root.name;
                font-size: 12px;
                font-weight: FontWeight.medium;
                color: #333333;
            }

            Text {
                text: "@" + root.login;
                font-size: 10px;
                color: #999999;
            }
        }

        Rectangle { }

        Text {
            text: root.bio;
            width: 170px;
            font-size: 10px;
            color: #aaaaaa;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component Settings inherits HorizontalLayout {
    in property <string> app_version;
    in property <string> node_id: "";
    in property <[Contributor]> contributors;
    in property <ContributorStatus> contributor_status: ContributorStatus.Loading;
    in property <bool> show_version: true;
    in property <bool> enabled_update_check: false;

    callback check_update_requested;
    callback open_url(url: string);
    callback copy_node_id;

    Rectangle {
        width: 250px;

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding-top: 0px;
            padding-bottom: 12px;

            SidebarHeader {
                title: "设置";
            }

            Rectangle {
                height: 8px;
            }

            HorizontalLayout {
                height: 24px;
                padding-left: 18px;
                padding-right: 16px;
                cross-axis-alignment: center;

                Text {
                    text: "应用";
                    font-size: 10px;
                    font-weight: FontWeight.medium;
                    color: #999999;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 2px;

                SettingsNavItem {
                    label: "关于";
                    icon: IconSet.Info;
                    active: true;
                }
            }
        }
    }

    Rectangle {
        width: 1px;
        background: #eeeeee;
    }

    right_pane := Rectangle {
        width: root.width - 251px;
        clip: true;

        VerticalLayout {
            width: 100%;
            height: 100%;

            HorizontalLayout {
                height: 48px;
                padding-left: 16px;
                padding-right: 16px;
                cross-axis-alignment: center;

                Text {
                    text: "关于";
                    font-size: 14px;
                    font-weight: FontWeight.semi-bold;
                    color: #333333;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 1px;
                background: #eeeeee;
            }

            Rectangle {
                height: 64px;
                background: #fafafa;

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 16px;
                    cross-axis-alignment: center;

                    Text {
                        text: "我的节点 ID";
                        font-size: 12px;
                        font-weight: FontWeight.medium;
                        color: #555555;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.node_id == "" ? "尚未生成" : root.node_id;
                        horizontal-stretch: 1;
                        font-size: 11px;
                        color: #666666;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Button {
                        height: 28px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #e5e5e5;
                        normal_background: #ffffff;
                        hover_background: #f7f7f7;
                        pressed_background: #eeeeee;
                        content-padding-left: 12px;
                        content-padding-right: 12px;

                        Text {
                            text: "复制";
                            font-size: 11px;
                            color: #333333;
                        }

                        clicked => {
                            root.copy_node_id();
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #eeeeee;
            }

            Rectangle {
                vertical-stretch: 1;
                max-height: 100000px;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding-top: 48px;
                    cross-axis-alignment: center;

                    VerticalLayout {
                        width: min(parent.width - 96px, 420px);
                        height: self.preferred-height;
                        vertical-stretch: 0;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 88px;
                            height: 88px;
                            border-radius: 22px;
                            background: #f7f7f7;
                            border-width: 1px;
                            border-color: #ededed;

                            VerticalLayout {
                                width: 100%;
                                height: 100%;
                                alignment: center;
                                cross-axis-alignment: center;

                                Image {
                                    width: 60px;
                                    height: 60px;
                                    source: @image-url("../../../../../../icon.svg");
                                }
                            }
                        }

                        Rectangle {
                            height: 18px;
                        }

                        Text {
                            text: "Pupu";
                            width: 100%;
                            font-size: 22px;
                            font-weight: FontWeight.semi-bold;
                            color: #222222;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            height: 6px;
                        }

                        Text {
                            text: "跨平台的 P2P 即时通讯软件";
                            width: 100%;
                            font-size: 12px;
                            color: #888888;
                            horizontal-alignment: center;
                        }

                        if root.show_version: Rectangle {
                            height: 14px;
                        }

                        if root.show_version: Rectangle {
                            width: version_text.preferred-width + 18px;
                            height: 22px;
                            border-radius: 11px;
                            background: #f2f2f2;

                            version_text := Text {
                                text: "版本 " + root.app_version;
                                font-size: 10px;
                                color: #666666;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                x: 9px;
                                y: 0px;
                                width: parent.width - 18px;
                                height: parent.height;
                            }
                        }

                        if root.enabled_update_check: Rectangle {
                            height: 14px;
                        }

                        if root.enabled_update_check: HorizontalLayout {
                            width: 100%;
                            height: 34px;
                            alignment: center;

                            Button {
                                height: 34px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #e5e5e5;
                                normal_background: #ffffff;
                                hover_background: #f7f7f7;
                                pressed_background: #eeeeee;
                                content-padding-left: 14px;
                                content-padding-right: 14px;
                                content-spacing: 6px;

                                IconDisplay {
                                    icon: IconSet.RefreshCw;
                                    size: 14px;
                                    stroke: #444444;
                                }

                                Text {
                                    text: "检查更新";
                                    font-size: 12px;
                                    color: #333333;
                                }

                                clicked => {
                                    root.check_update_requested();
                                }
                            }
                        }

                        Rectangle {
                            height: root.enabled_update_check
                                ? 28px
                                : (root.show_version ? 44px : 40px);
                        }

                        Rectangle {
                            width: 100%;
                            height: 1px;
                            background: #ededed;
                        }

                        Rectangle {
                            height: 24px;
                        }

                        HorizontalLayout {
                            width: 100%;
                            cross-axis-alignment: center;

                            Text {
                                text: "贡献者";
                                font-size: 12px;
                                font-weight: FontWeight.semi-bold;
                                color: #555555;
                            }

                            Rectangle { }

                            if root.contributor_status == ContributorStatus.Loaded: Text {
                                text: root.contributors.length.to-string-unlocalized() + " 位";
                                font-size: 10px;
                                color: #aaaaaa;
                            }
                        }

                        Rectangle {
                            height: 6px;
                        }
                    }

                    Rectangle {
                        width: min(parent.width - 96px, 420px);
                        vertical-stretch: 1;

                        hover_touch := TouchArea {
                        }

                        contributors_list := ListView {
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                            for contributor in root.contributors: ContributorRow {
                                avatar: contributor.avatar;
                                name: contributor.name;
                                login: contributor.login;
                                bio: contributor.bio;

                                clicked => {
                                    root.open_url("https://github.com/" + contributor.login);
                                }
                            }
                        }

                        if root.contributor_status == ContributorStatus.Loading: Text {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 46px;
                            text: "正在获取贡献者列表";
                            font-size: 11px;
                            color: #aaaaaa;
                            vertical-alignment: center;
                        }

                        if root.contributor_status == ContributorStatus.Failed: Text {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 46px;
                            text: "贡献者列表获取失败";
                            font-size: 11px;
                            color: #aaaaaa;
                            vertical-alignment: center;
                        }

                        HoverScrollBar {
                            x: parent.width + 6px;
                            width: 12px;
                            height: parent.height;
                            content_y <=> contributors_list.content-y;
                            content_height: contributors_list.content-height;
                            visible_height: contributors_list.height;
                            hovered: hover_touch.has-hover;
                        }
                    }
                }
            }
        }
    }
}
