{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "pupu",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "pupu.zhangxichang.com",
      "custom_domain": true
    }
  ],
  "main": "wrangler.js",
  "assets": {
    "directory": "dist",
    "binding": "assets",
    "run_worker_first": [
      "/pupu-*_bg.wasm"
    ]
  },
  "r2_buckets": [
    {
      "bucket_name": "pupu-apac",
      "binding": "r2"
    }
  ]
}